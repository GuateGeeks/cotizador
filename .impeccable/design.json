  "narrative": {
    "northStar": "Campus vivo del asesor",
    "overview": "La configuración educativa conserva una columna compacta y una escuela animada muestra actividades que se pueden explorar. Cada decisión produce una explicación contextual con las cantidades y condiciones reales del configurador.",
    "keyCharacteristics": [
      "Configuración lateral de 360–420 px; campus claro (#F4F1F6) en el espacio restante.",
      "Actividades seleccionables mediante canvas y tira de tecnologías; foco destacado en primer plano.",
      "Móvil compacto (260–380 px) con «Ampliar»; 130–140 px al editar campos.",
      "Actividad visible con máximo configurado de 30 FPS; sin afirmar rendimiento medido.",
      "Modalidades explicadas mediante diagramas, sin edificios ni servicios añadidos."
    ],
    "rules": [
      {
        "name": "Foco y configuración",
        "body": "Conservar canvas, cámara y foco de edición. Explorar una tecnología no cambia la cotización; el control de la ficha permite abrir su configuración.",
        "section": "components"
      },
      {
        "name": "Actividad y pausa",
        "body": "Animar actividades relacionadas con el aprendizaje mientras el campus es visible. Pausa, movimiento reducido y ocultación detienen la actividad; los datos y controles siguen disponibles.",
        "section": "motion"
      }
    ],
    "dos": [
      "Relacionar la respuesta visual y la explicación con la decisión editada.",
      "Mantener cantidades exactas del motor junto a representaciones agrupadas.",
      "Usar #F4F1F6 como fondo del visor, vidrio claro para el HUD, #321853 para titulares y #58446f para explicación.",
      "Preservar el espacio de edición móvil compactando temporalmente el campus."
    ],
    "donts": [
      "No añadir edificios por avanzar de paso o cambiar únicamente de modalidad.",
      "No convertir la maqueta o sus actividades en una promesa de capacidad física.",
      "No mantener cuadros o temporizadores de actividades cuando el campus está pausado u oculto.",
      "No presentar el máximo configurado de 30 FPS como rendimiento medido."
    ]
  }
